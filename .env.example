NEXT_PUBLIC_SITE_URL=https://datvang.example

# Verified company hotline used by call buttons (leave empty until supplied).
NEXT_PUBLIC_COMPANY_PHONE=
# Floating contact buttons and footer (defaults: 0911296979 and the company fanpage).
NEXT_PUBLIC_ZALO_PHONE=
NEXT_PUBLIC_WHATSAPP_PHONE=
NEXT_PUBLIC_FACEBOOK_URL=

# BE-DVG base URL reachable from the Next.js server (private network in production).
API_INTERNAL_URL=http://127.0.0.1:4000
# Shared with BE-DVG (REVALIDATE_SECRET): authorises cache invalidation webhooks.
REVALIDATE_SECRET=
# Absolute media/CDN base URLs allowed for next/image, comma separated
# (e.g. https://media.datvanggroup.vn). Same-origin /media needs no entry.
MEDIA_REMOTE_PATTERNS=
